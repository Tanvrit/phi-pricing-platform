<configuration>
    <!--
        Conversion rules for PII masking. Replaces Aadhaar / mobile / PAN patterns in
        every log message with masked versions. Defence-in-depth: code should not log
        PII at all, but if it slips through (third-party libs, stack traces, etc.) the
        mask catches it.

        For full structured logging, swap the pattern encoder for
        net.logstash.logback.encoder.LogstashEncoder once the dependency is wired.
    -->
    <conversionRule conversionWord="piimsg"
                    converterClass="com.rate.server.logging.PiiMaskingConverter"/>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{ISO8601} [%thread] %-5level %logger{36} - %piimsg%n</pattern>
        </encoder>
    </appender>

    <!--
        Disk sink for the /api/admin/log operator tail endpoint. Same masked pattern
        as STDOUT so the on-disk file never contains plaintext PII even if a library
        leaks it. Rolling daily + gzipped, 14-day retention keeps disk usage bounded
        without operator intervention. The file path is RELATIVE to the server's CWD
        — when launched via `./gradlew :server:run` that's the repo root; in Docker
        it's the workdir set by the Dockerfile.
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/aegis.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/aegis.%d{yyyy-MM-dd}.log.gz</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{ISO8601} [%thread] %-5level %logger{36} - %piimsg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="STDOUT" />
        <appender-ref ref="FILE" />
    </root>

    <logger name="io.ktor" level="INFO"/>
    <!-- Mongo driver at WARN to avoid leaking query/collection chatter. -->
    <logger name="org.mongodb.driver" level="WARN"/>
    <logger name="com.rate" level="INFO"/>
</configuration>
